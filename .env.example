# =============================================================================
# Village Guard Backend — ตัวอย่างไฟล์ตั้งค่า
# วิธีใช้: cp .env.example .env แล้วแก้ทุกค่าที่เป็น change-me / your-domain.example
# ห้าม commit ไฟล์ .env จริงเข้า git (อยู่ใน .gitignore แล้ว)
# ตัวแปรที่ไม่มีค่า default ต้องมีครบ ไม่งั้น api จะไม่ start (Field required)
# =============================================================================


# ---------- Database ----------
# docker-compose.yml ใช้ 3 ตัวนี้สร้างฐานข้อมูลใน container "db"
# POSTGRES_PASSWORD มีผลแค่ตอนสร้าง volume ครั้งแรก ถ้าจะเปลี่ยนภายหลังต้อง ALTER USER ในฐานข้อมูลก่อน
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=YOLO_PROJECT

# ต้องมีเสมอ แต่เวลารันด้วย docker compose ค่านี้จะถูกแทนที่ด้วยค่าที่ประกอบจาก POSTGRES_* (host = db)
# ค่านี้ถูกใช้จริงเฉพาะตอนรันนอก docker เช่น alembic / uvicorn บนเครื่องนักพัฒนา
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/YOLO_PROJECT


# ---------- Auth / JWT ----------
# สร้างค่าใหม่ด้วย: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# อายุ refresh token เมื่อติ๊ก "จดจำฉัน" (วัน)
REFRESH_TOKEN_EXPIRE_DAYS=7
# อายุ refresh token เมื่อไม่ติ๊ก "จดจำฉัน" (ชั่วโมง)
REFRESH_TOKEN_SESSION_EXPIRE_HOURS=12


# ---------- Cookie (refresh token) ----------
# ค่าที่รับได้: lax / strict / none
# ถ้าตั้ง none ต้องตั้ง COOKIE_SECURE=true ด้วย ไม่งั้น api จะไม่ start
COOKIE_SAMESITE=lax
# เว็บที่ใช้งานผ่าน HTTPS ควรเป็น true / ตั้ง false เฉพาะตอนทดสอบผ่าน http
COOKIE_SECURE=true
# เว้นว่างไว้ = ใช้ได้เฉพาะโดเมนที่ตอบ request
COOKIE_DOMAIN=


# ---------- URL / CORS / Proxy ----------
# URL ของหน้าเว็บ ใช้สร้างลิงก์ในอีเมล (ตั้งรหัสผ่าน / ยืนยันอีเมล) ไม่ต้องมี / ปิดท้าย
FRONTEND_URL=https://your-domain.example
# URL ที่ AI Vision ใช้ยิง webhook กลับมา (ระบบจะต่อท้ายด้วย /api/detections ให้เอง)
BACKEND_PUBLIC_URL=https://your-domain.example
# origin ที่อนุญาต คั่นด้วย comma
CORS_ALLOWED_ORIGINS=https://your-domain.example

# true เมื่อ api อยู่หลัง reverse proxy (nginx) เพื่อให้อ่าน IP จริงจาก X-Forwarded-For
TRUST_PROXY_HEADERS=true
# จำนวน proxy ที่อยู่หน้า api: nginx อย่างเดียว = 1 / มี proxy HTTPS หรือ load balancer หน้า nginx อีกชั้น = 2
# ตั้งผิดแล้ว rate limit จะนับผู้ใช้ทุกคนเป็น IP เดียวกัน (โดน 429 ทั้งระบบ) หรือถูกปลอม IP ได้
TRUSTED_PROXY_HOPS=2


# ---------- AI Vision ----------
# key ที่ AI Vision ต้องส่งมาใน header เมื่อยิง POST /api/detections (ฝั่งเรา "รับ")
# สร้างค่าใหม่ด้วย: openssl rand -hex 32 แล้วส่งให้ทีม AI Vision
API_KEY_HEADER_NAME=X-API-Key
API_KEY=change-me

# ที่อยู่ของ AI Vision และ key ที่เราส่งไปเมื่อลงทะเบียน/ปิด/ลบกล้อง (ฝั่งเรา "ส่ง") — ได้จากทีม AI Vision
AI_VISION_API_URL=http://ai-vision-host:8081
AI_VISION_API_KEY=change-me


# ---------- MediaMTX (Live stream) ----------
# api เรียก MediaMTX API ภายใน docker network ต้องใช้ชื่อ service "mediamtx" ไม่ใช่ localhost
# (ใช้ http://localhost:9997 เฉพาะตอนรัน api นอก docker)
MEDIAMTX_API_URL=http://mediamtx:9997
# URL สาธารณะของ HLS ผ่าน nginx (path /mediamtx/)
MEDIAMTX_PUBLIC_URL=https://your-domain.example/mediamtx
# user/pass ที่ api ส่งไปกับทุก request ของ MediaMTX API (docker-compose.yml ตั้งค่าเดียวกันให้ MediaMTX)
# หมายเหตุ: ตอนนี้ MediaMTX ไม่ได้ตรวจค่านี้ เพราะ mediamtx.yml ตั้ง authHTTPExclude: api ไว้ พอร์ต 9997 จึงต้องเปิดเฉพาะ 127.0.0.1
MEDIAMTX_API_USER=change-me
MEDIAMTX_API_PASSWORD=change-me
# EC private key (P-256) แบบ PEM เข้ารหัส base64 บรรทัดเดียว ใช้เซ็น token ดูกล้อง (ES256)
# สร้างด้วย: openssl ecparam -name prime256v1 -genkey -noout | base64 -w0
MEDIAMTX_JWT_PRIVATE_KEY_B64=change-me
# อายุ token ดูกล้อง (วินาที) — ไม่มีค่า default ต้องใส่
MEDIAMTX_STREAM_TOKEN_EXPIRE_SECONDS=300


# ---------- Email (SMTP) ----------
# ใช้ STARTTLS (พอร์ต 587) / ถ้าใช้ Gmail ต้องใช้ App Password ไม่ใช่รหัสผ่านบัญชี
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=change-me@example.com


# ---------- Storage / SSE ----------
# โฟลเดอร์เก็บรูปป้าย รูปเต็ม และ avatar (docker-compose.yml mount ./storage ไว้ที่ /app/storage)
STORAGE_PATH=./storage
# อายุ ticket สำหรับเปิด SSE stream (วินาที) ใช้ได้ครั้งเดียว
SSE_TICKET_EXPIRE_SECONDS=30


# ---------- ค่าปรับจูน (ไม่ต้องตั้งก็ได้ ค่าด้านล่างคือค่า default ในโค้ด) ----------
# REFRESH_REUSE_GRACE_SECONDS=30
# AUTH_MAX_SESSIONS_PER_USER=5
# AUTH_REFRESH_COOKIE_PATH=/api/auth
# SSE_REVALIDATION_INTERVAL_SECONDS=30
# SSE_MAX_STREAMS_PER_SESSION=5
# CHANNEL_QUEUE_SIZE=100
# CAMERA_RESYNC_CONCURRENCY_LIMIT=10
# CAMERA_MANUAL_VERIFY_RATE_LIMIT=1
# CAMERA_MANUAL_VERIFY_RATE_WINDOW_SECONDS=30
# CAMERA_VERIFY_POLL_INTERVAL_SECONDS=2
# CAMERA_VERIFY_MAX_DURATION_SECONDS=60
# BLACKLIST_EMAIL_ALERT_COOLDOWN_SECONDS=900
# CONTACT_MAX_PER_USER=50
# PRESENCE_SWEEP_INTERVAL_SECONDS=60
# PRESENCE_BROADCAST_DEBOUNCE_SECONDS=0.3
# USER_AVATAR_MAX_SIZE_BYTES=2097152
